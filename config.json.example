{
  "api": {
    "key": "sk-xxx",
    "base_url": "https://api.deepseek.com/v1",
    "model": "hepai/deepseek-v4.1-flash",
    "max_tokens": 16384,
    "params": {
      "reasoning_effort": "none"
    }
  },
  "server": {
    "host": "0.0.0.0",
    "port": 16625
  },
  "translator": {
    "concurrency": 3
  },
  "sources": [
    { "type": "arxiv_html" },
    { "type": "ar5iv" },
    { "type": "ar5ivist_docker" }
  ],
  "ar5ivist_docker_image": "latexml/ar5ivist:2512.17",
  "chat": {
    "idle_timeout": 900,
    "tools": "read,grep,find,ls",
    "pi_bin": "pi",
    "allow_remote": false,
    "model": null,
    "thinking": null
  }
}
